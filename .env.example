# --- LLM provider (loop/models.py) ---
CAREERPILOT_PROVIDER=anthropic
CAREERPILOT_MODEL=
CAREERPILOT_API_KEY=

# --- Qdrant: semantic memory (memory/semantic/qdrant_store.py) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=careerpilot_semantic
CAREERPILOT_EMBEDDING_MODEL=

# GROQ API

CAREERPILOT_PROVIDER=groq
CAREERPILOT_API_KEY=
CAREERPILOT_MODEL=llama-3.3-70b-versatile

# Groq has no embeddings endpoint — you need a real OpenAI key just for this:
# CAREERPILOT_EMBEDDING_API_KEY=<your openai key>
CAREERPILOT_EMBEDDING_PROVIDER=fastembed
CAREERPILOT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- SQLite: episodic memory (memory/episodic/sqlite_store.py) ---
CAREERPILOT_SQLITE_PATH=.careerpilot/state.db

# --- loop guardrails (loop/agent.py) ---
CAREERPILOT_MAX_ITERATIONS=10
CAREERPILOT_MAX_TOKENS=2048

# --- job search tool (tools/search_jobs.py) ---
TAVILY_API_KEY=

# --- MCP (tools/mcp_loader.py) ---
CAREERPILOT_MCP_CONFIG=.careerpilot/mcp.json

# --- experimental/roadmap tools (tools/experimental.py) ---
# set to 1 to register delegate_task / draft_outreach_email / auto_apply
CAREERPILOT_EXPERIMENTAL=0

# --- Telegram gateway (gateway/telegram.py) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER=

# --- dashboard gateway (gateway/dashboard/app.py) ---
CAREERPILOT_DASHBOARD_HOST=127.0.0.1
CAREERPILOT_DASHBOARD_PORT=7777

# --- ops (ops/tracing.py, ops/usage.py) ---
CAREERPILOT_TRACE_DIR=.careerpilot/traces
CAREERPILOT_USAGE_LOG=.careerpilot/usage.jsonl

# NOTION API KEY.
NOTION_API_KEY=